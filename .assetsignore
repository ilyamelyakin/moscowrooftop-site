# Исходники-оригиналы: страницы ссылаются только на уменьшенные варианты
# (roof-1-640.jpg, hero-fallback-1280.webp и так далее). Проверено перебором
# всех html/css/js — на сами оригиналы не ссылается никто, а в деплой они
# уносили 17 МБ. Шаблоны с диапазоном, а не с одним «?»: иначе roof-10.jpg
# уехал бы наружу. Уменьшенные варианты под них не попадают — у них между
# именем и расширением есть «-640».
/assets/roof-[0-9].jpg
/assets/roof-[0-9][0-9].jpg
/assets/hero-*.jpg
!/assets/hero-*-[0-9][0-9][0-9]*.jpg

# Видео на страницах сейчас нет вовсе. Глобально, а не только в assets/:
# рядом MOV и HEIC закрыты так же, и перенос файла в подпапку не должен
# внезапно выкладывать его наружу.
*.mp4
*.MP4

# Секреты и мусор сборки. Тот же класс, что и .wrangler/: assets.directory = "."
# означает «выкладываем весь корень, кроме перечисленного», поэтому любой
# случайно созданный .env или .dev.vars (штатный файл wrangler для локальных
# секретов) оказался бы в публичном доступе.
.env
.env.*
.dev.vars
.dev.vars.*
secrets/
node_modules/
*.log
*.zip
*.sql
*.bak
*.sqlite
*.sqlite3

# Редакторское.
.idea/
.vscode/

# Служебное и внутреннее — в публичную выдачу попадать не должно.
# .wrangler появляется от локального `wrangler dev` и тащит с собой
# исходник воркера (tmp/deploy-*/index.js) и кеш аккаунта.
.wrangler/
.claude/
design/
