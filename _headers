# Cloudflare Pages custom headers.
# Keep CSP out of this file for now: analytics scripts are configured in script.js.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=2592000

/*.css
  Cache-Control: public, max-age=2592000

/*.js
  Cache-Control: public, max-age=2592000

# Каталог открывается внутри Telegram: на web.telegram.org Mini App живёт в iframe,
# поэтому унаследованный X-Frame-Options тут снимаем и разрешаем встраивание точечно.
/katalog/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors 'self' https://web.telegram.org https://*.telegram.org
  Cache-Control: public, max-age=300
